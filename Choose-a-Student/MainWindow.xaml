<Window x:Class="Choose_a_Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Choose_a_Student"
        mc:Ignorable="d"
        Title="课堂点名"
        Height="340" Width="480"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStartupLocation="CenterScreen">
    <Border Margin="24"
            Padding="24"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                              Direction="270" Opacity="0.16" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="课堂点名"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <Button x:Name="SelectFileButton"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Content="选择名单文件"
                    HorizontalAlignment="Left"
                    Click="SelectFileButton_Click" />

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="FilePathText"
                           Text="名单文件：未选择"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountText"
                           Text="人数：0"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <CheckBox x:Name="ShowBallCheckBox"
                      Grid.Row="3"
                      Margin="0,16,0,0"
                      Content="显示悬浮球"
                      Checked="ShowBallCheckBox_Changed"
                      Unchecked="ShowBallCheckBox_Changed" />
        </Grid>
    </Border>
</Window>
